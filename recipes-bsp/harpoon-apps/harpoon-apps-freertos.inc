LIC_FILES_CHKSUM = " \
    file://mcux-sdk/LA_OPT_NXP_Software_License.txt;md5=10c0fda810c63b052409b15a5445671a \
    file://mcux-sdk/CMSIS/LICENSE.txt;md5=e3fc50a88d0a364313df4b21ef20c29e \
