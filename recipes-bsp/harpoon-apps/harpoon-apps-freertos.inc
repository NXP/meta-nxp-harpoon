CORE_ID:imx95-19x19-lpddr5-evk = "ca55"

INMATES_DIR ?= "${HARPOON_DATADIR}/inmates/freertos"

BUILD_TYPE = "ddr_release"

HARPOON_APPS_CODE_DIR = "${S}/harpoon-apps/${HARPOON_APPS_APP}/freertos"

do_install() {
	install -d ${D}${INMATES_DIR}
	install -m 0644 ${B}/${HARPOON_APPS_APP_BIN} ${D}${INMATES_DIR}
}

do_configure:prepend () {
	export ARMGCC_DIR="${WORKDIR}/recipe-sysroot-native${bindir}/${ARM_TC}-native-${ARM_PV}/"

	if [ -d "CMakeFiles" ];then rm -rf CMakeFiles; fi
	if [ -f "Makefile" ];then rm -f Makefile; fi
	if [ -f "cmake_install.cmake" ];then rm -f cmake_install.cmake; fi
	if [ -f "CMakeCache.txt" ];then rm -f CMakeCache.txt; fi
}

SECURITY_STACK_PROTECTOR = ""
OECMAKE_SOURCEPATH = "${HARPOON_APPS_CODE_DIR}"
OECMAKE_GENERATOR = "Ninja"
# Remove default toolchain file generated by cmake class
OECMAKE_ARGS:remove="-DCMAKE_TOOLCHAIN_FILE:FILEPATH=${WORKDIR}/toolchain.cmake"
EXTRA_OECMAKE += "-DSdkRootDirPath=${S}/mcuxsdk/mcuxsdk -Dboard=${BOARD} -Dcore_id=${CORE_ID} -DCONFIG_TOOLCHAIN=armgcc -DCMAKE_BUILD_TYPE=${BUILD_TYPE} ${EXTRA_HARPOON_FLAGS}"

INSANE_SKIP:${PN} += "buildpaths"
