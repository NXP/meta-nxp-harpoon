From cc848c8b35c891f5896a1fd469d512de8cb5d48d Mon Sep 17 00:00:00 2001
From: Aziz Sellami <aziz.sellami@nxp.com>
Date: Fri, 18 Apr 2025 16:04:23 +0200
Subject: [PATCH 32/36] dts: imx95-15x15-evk-harpoon-industrial: disable
 ethernet0 on Linux

Adapt harpoon industrial device tree for i.MX 95 15x15 LPDDR4x EVK:
     - Disable enetc_port0, ethphy0 and netc_timer for usage in inmate cell

Upstream-Status: Pending

Signed-off-by: Aziz Sellami <aziz.sellami@nxp.com>
---
 .../freescale/imx95-15x15-evk-harpoon-industrial.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx95-15x15-evk-harpoon-industrial.dts b/arch/arm64/boot/dts/freescale/imx95-15x15-evk-harpoon-industrial.dts
index fc2caf693bfe..0f97e3d59621 100644
--- a/arch/arm64/boot/dts/freescale/imx95-15x15-evk-harpoon-industrial.dts
+++ b/arch/arm64/boot/dts/freescale/imx95-15x15-evk-harpoon-industrial.dts
@@ -23,3 +23,15 @@ &flexcan2 {
 &reg_can2_stby {
 	status = "disabled";
 };
+
+&enetc_port0 {
+	status = "disabled";
+};
+
+&ethphy0 {
+	status = "disabled";
+};
+
+&netc_timer {
+	status = "disabled";
+};
-- 
