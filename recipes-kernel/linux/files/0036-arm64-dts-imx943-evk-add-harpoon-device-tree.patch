From 8d54ee47d4ea5507d912ecb6ba732b4d6ed3b9fd Mon Sep 17 00:00:00 2001
From: Aziz Sellami <aziz.sellami@nxp.com>
Date: Thu, 2 Oct 2025 10:28:48 +0200
Subject: [PATCH 36/38] arm64: dts: imx943-evk: add harpoon device tree

Upstream-Status: Pending

Signed-off-by: Aziz Sellami <aziz.sellami@nxp.com>
---
 .../boot/dts/freescale/imx943-evk-harpoon.dts |  9 +++++
 .../dts/freescale/imx943-generic-mbox.dtsi    | 27 ++++++++++++++
 .../boot/dts/freescale/imx943-rpmsg-ca55.dtsi | 37 +++++++++++++++++++
 3 files changed, 73 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx943-evk-harpoon.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx943-generic-mbox.dtsi
 create mode 100644 arch/arm64/boot/dts/freescale/imx943-rpmsg-ca55.dtsi

diff --git a/arch/arm64/boot/dts/freescale/imx943-evk-harpoon.dts b/arch/arm64/boot/dts/freescale/imx943-evk-harpoon.dts
new file mode 100644
index 000000000000..0ffcc9303136
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx943-evk-harpoon.dts
@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2025 NXP
+ */
+
+/dts-v1/;
+
+#include "imx943-evk-root.dts"
+#include "imx943-rpmsg-ca55.dtsi"
diff --git a/arch/arm64/boot/dts/freescale/imx943-generic-mbox.dtsi b/arch/arm64/boot/dts/freescale/imx943-generic-mbox.dtsi
new file mode 100644
index 000000000000..2def9a9df059
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx943-generic-mbox.dtsi
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2025 NXP
+ */
+
+/ {
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		gen_sw_mbox_reserved: gen-sw-mbox@c0000000 {
+			reg = <0 0xc0000000 0 0x1000>;
+			no-map;
+		};
+
+	};
+
+	gen_sw_mbox: generic-software-mailbox@c0000000 {
+		compatible = "fsl,generic-software-mbox";
+		reg = <0 0xc0000000 0 0x1000>;
+		#mbox-cells = <3>;
+		/* Use 2 unused SPI interrupts */
+		interrupts = <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 215 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "irq", "remote_irq";
+	};
+};
diff --git a/arch/arm64/boot/dts/freescale/imx943-rpmsg-ca55.dtsi b/arch/arm64/boot/dts/freescale/imx943-rpmsg-ca55.dtsi
new file mode 100644
index 000000000000..f8fdf620199c
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx943-rpmsg-ca55.dtsi
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2025 NXP
+ */
+
+#include "imx943-generic-mbox.dtsi"
+
+/ {
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		rpmsg_ca55_reserved: rpmsg-ca55@c0100000 {
+			reg = <0 0xc0100000 0 0x10000>;
+			no-map;
+		};
+
+		vdevbuffer_ca55: vdevbuffer-ca55@c0200000 {
+			compatible = "shared-dma-pool";
+			reg = <0 0xc0200000 0 0x100000>;
+			no-map;
+		};
+	};
+
+	rpmsg-ca55 {
+		compatible = "fsl,imx8mm-rpmsg";
+		reg = <0x0 0xc0100000 0x0 0x10000>; /* 64K for one rpmsg instance */
+		dma-coherent;
+		memory-region = <&vdevbuffer_ca55>;
+		mbox-names = "tx", "rx", "rxdb";
+		mboxes = <&gen_sw_mbox 0 0 1	/* Tx channel with ACK */
+			  &gen_sw_mbox 1 0 0	/* Rx channel without ACK */
+			  &gen_sw_mbox 2 0 1>;	/* RXDB channel with ACK */
+		vdev-nums = <1>;
+	};
+};
-- 
2.34.1

