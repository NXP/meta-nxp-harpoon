require harpoon-apps-common.inc
require harpoon-apps-uri.inc
require rtos-abstraction-layer-uri.inc
require rtos-apps-uri.inc

inherit python3native

LICENSE = "BSD-3-Clause & Apache-2.0 & Proprietary"
LIC_FILES_CHKSUM = " \
    file://zsdk/zephyr/LICENSE;md5=fa818a259cbed7ce8bc2a22d35a464fc \
    file://zsdk/modules/hal/nxp/LICENSE.BSD-3;md5=0858ec9c7a80c4a2cf16e4f825a2cc91 \
    file://zsdk/modules/crypto/els_pkc/LICENSE_Apache-2.0.txt;md5=175792518e4ac015ab6696d16c4f607e \
    file://zsdk/modules/crypto/psa_crypto_driver/LICENSE;md5=b66f32a90f9577a5a3255c21d79bc619 \
    file://harpoon-apps/LICENSE;md5=b1a3c7f4e16fc8aa105097dd385e900f \
    file://rtos-abstraction-layer/LICENSE.txt;md5=0d6849a6649fa03a6242a4ed265e06ae \
    file://rtos-apps/LICENSE.txt;md5=0d6849a6649fa03a6242a4ed265e06ae \
"

ZEPHYR_BRANCH  = "feature/heterogeneous_multicore"
HAL_NXP_BRANCH = "feature/heterogeneous_multicore"

SRC_URI = "\
    ${SRC_HARPOON_APPS} \
    ${SRC_RTOS_ABSTRACTION_LAYER} \
    ${SRC_RTOS_APPS} \
    git://github.com/nxp-zephyr/zephyr.git;protocol=https;nobranch=1;destsuffix=git/zsdk/zephyr;name=zephyr \
    git://github.com/nxp-zephyr/hal_nxp.git;protocol=https;nobranch=1;destsuffix=git/zsdk/modules/hal/nxp;name=hal-nxp \
    git://github.com/nxp/els_pkc.git;protocol=https;nobranch=1;destsuffix=git/zsdk/modules/crypto/els_pkc;name=els_pkc \
    git://github.com/nxp/psa_crypto_driver.git;protocol=https;nobranch=1;destsuffix=git/zsdk/modules/crypto/psa_crypto_driver;name=psa_crypto_driver \
"

SRCREV_FORMAT = "harpoon-apps_zephyr_hal-nxp_els_pkc_psa_crypto_driver_rtos-abstraction-layer_rtos-apps"

SRCREV_zephyr = "efe550bc592742561c171381b5c3a1c9b2e2630b"
SRCREV_hal-nxp = "df59b170b903256d08c57054a6d43b0592d4d692"
# mcux-sdk-ng Kconfig in hal_nxp requires Kconfig symbols from els_pkc and psa_crypto_driver
SRCREV_els_pkc = "71d4a89c03fb32e618ee02c0cd54b3fc92736c96"
SRCREV_psa_crypto_driver = "1a93893f986db38cf2c8910f6138b634f0437a48"

INMATES_DIR ?= "${HARPOON_DATADIR}/inmates/zephyr"

HARPOON_APPS_CODE_DIR = "${S}/harpoon-apps/${HARPOON_APPS_APP}/zephyr"

do_install() {
	install -d ${D}${INMATES_DIR}
	install -m 0644 ${B}/zephyr/${HARPOON_APPS_APP_BIN} ${D}${INMATES_DIR}
}

do_configure:prepend () {
	export ARMGCC_DIR="${WORKDIR}/recipe-sysroot-native${bindir}/${ARM_TC}-native-${ARM_PV}/"
	export ZEPHYR_TOOLCHAIN_VARIANT=cross-compile
	export CROSS_COMPILE="${ARMGCC_DIR}"bin/aarch64-none-elf-
	export Zephyr_DIR="${S}/zsdk/zephyr"
}

SECURITY_STACK_PROTECTOR = ""
OECMAKE_SOURCEPATH = "${HARPOON_APPS_CODE_DIR}"
OECMAKE_GENERATOR = "Ninja"
ZEPHYR_MODULES = "'${S}/rpmsg-lite;${S}/zsdk/modules/hal/nxp;${S}/zsdk/modules/crypto/els_pkc;${S}/zsdk/modules/crypto/psa_crypto_driver'"
EXTRA_OECMAKE += "-DBOARD=${BOARD} -DZEPHYR_MODULES=${ZEPHYR_MODULES} ${EXTRA_HARPOON_FLAGS}"
# Remove default toolchain file generated by cmake class
OECMAKE_ARGS:remove="-DCMAKE_TOOLCHAIN_FILE:FILEPATH=${WORKDIR}/toolchain.cmake"

DEPENDS += "python3-packaging-native"
DEPENDS += "python3-pyelftools-native"
DEPENDS += "python3-pykwalify-native"
DEPENDS += "python3-pyyaml-native"
DEPENDS += "python3-jsonschema-native"
